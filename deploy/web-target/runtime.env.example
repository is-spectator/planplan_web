# Non-secret systemd EnvironmentFile. Fill the domain/release before installing.
NODE_ENV=production
DEPLOYMENT_ENV=beta
HOST=127.0.0.1
PORT=8789
PLANPLAN_SECRETS_FILE=/etc/planplan-web/secrets/runtime.json
PG_CA_FILE=/etc/planplan-web/pg-ca.pem
LEGAL_CONFIG_PATH=/etc/planplan-web/legal.json
RELEASE_ID=REPLACE_WITH_SOURCE_MANIFEST_SHA256
WEB_ALLOWED_ORIGINS=https://REPLACE_WITH_CONFIRMED_WEB_DOMAIN
WEB_COOKIE_SECURE=1
TRUST_PROXY=1
DEV_LOGIN=0
EMAIL_AUTH_ENABLED=1
EMAIL_SMTP_HOST=smtp.qiye.aliyun.com
AI_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
OPENROUTER_OUTPUT=compact
OPENROUTER_TIMEOUT_MS=60000
# Trusted administrator UUIDs only. Never supplied by a browser request.
COMMUNITY_REVIEWER_USER_IDS=
# Do not configure a fallback model or AI_RUNTIME_CONFIG_PATH without review.
