# Loaded by Node, never sourced as shell code. Runtime secrets are separate.
DEPLOYMENT_ENV=beta
PG_CA_FILE=/etc/planplan-web/pg-ca.pem
PLANPLAN_SECRETS_FILE=/etc/planplan-web/backup-secrets.json
BACKUP_KEY_ID=REPLACE_WITH_ACTUAL_BACKUP_KEY_VERSION
# pg_dump/pg_restore must resolve to PostgreSQL 15.19 installed binaries.
PATH=/usr/bin:/bin
# Secret JSON: DATABASE_URL (dedicated owner), BACKUP_ENCRYPTION_KEY (base64 32B),
# BACKUP_LEDGER_KEY (independent random 32+ bytes). Never copy runtime/mail keys.
