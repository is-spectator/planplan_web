# Append only to the NEW independent cluster's generated postgresql.conf.
listen_addresses = '127.0.0.1'
port = 55432
unix_socket_directories = '/run/planplan-web-postgres'
unix_socket_permissions = 0700
password_encryption = 'scram-sha-256'
ssl = on
ssl_cert_file = '/etc/planplan-web-postgres/tls/server.crt'
ssl_key_file = '/etc/planplan-web-postgres/tls/server.key'
ssl_min_protocol_version = 'TLSv1.2'
max_connections = 60
shared_buffers = '128MB'
# Test suite uses many isolated schemas; two workers reduce DDL pressure.
max_locks_per_transaction = 256
log_statement = 'none'
log_min_duration_statement = -1
log_min_error_statement = 'panic'
log_parameter_max_length = 0
log_parameter_max_length_on_error = 0
log_connections = off
log_disconnections = off
# Driver errors can contain submitted values; do not persist raw server errors.
log_min_messages = 'panic'
