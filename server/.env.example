# Optional local real-model fixture configuration; no real credentials here.
# Copy to server/.env.openrouter.local and keep that file ignored by Git.
# Change PLANPLAN_FIXTURE_REAL_AI to 1 only for an intentional real-model run.
NODE_ENV=development
PLANPLAN_FIXTURE_REAL_AI=0
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
OPENROUTER_OUTPUT=compact
OPENROUTER_TIMEOUT_MS=60000
